    given-names: "Miqueas"
    email: "miqueasq@gmail.com"
version: "0.1.0"
date-released: "2026-11-14"
license: MIT
repository-code: "https://github.com/Miqueas7/BlastingPy"
url: "https://miqueas.dev/blastingpy"
keywords:
  - mining
  - blasting
  - ground vibration
  - PPV
  - airblast
  - flyrock
  - scaled distance
  - near field
